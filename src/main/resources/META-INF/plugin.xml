<idea-plugin>
    <id>org.stvnadore.plugin</id>
    <name>STVN Data Grammar Language</name>
    <vendor email="jim.oflaherty.jr@gmail.com">chaotic3quilibrium</vendor>

    <change-notes><![CDATA[
      <h3>2.0.0 - 2026.10.31</h3>
      <ul>
        <li><b>STVN 2.0.0 Pure-IR Architecture Cutover:</b>
          <ul>
            <li>Coupled type resolution, hover documentation, inlay hints, code completion, local inspections, and canonical projections directly to the immutable <code>org.stvnadore.core.ir</code> <code>StvnDocument</code>, <code>StvnDefsCatalog</code>, <code>StvnSchema</code>, and <code>StvnValue</code> record graph.</li>
            <li>Synchronized Grammar-Kit BNF and JFlex lexical tokens with the 6-file STVN 2.0.0 taxonomy (<code>.stvn</code>, <code>.stvn_i</code>, <code>.stvn_d</code>, <code>.stvn_di</code>, <code>.stvn_b</code>, <code>.stvn_bd</code>) and zero-argument standalone metadata flags.</li>
            <li>Enforced canonical fenced string opening delimiters (<code>"""[TAG]</code>) and facet-based string capacity governance (<code>{ #minSize 1 #maxSize N } :String</code>).</li>
            <li>Routed cross-file <code>:include</code> diagnostics directly via authoritative <code>StvnDiagnostic.sourcePath()</code> provenance and resolved inspection deconfliction via <code>StvnDiagnostic.symbolicId()</code>.</li>
            <li>Aligned remote schema repository publishing with <code>application/stvn; charset=utf-8</code> and full 7-field <code>CompileDiagnosticDto</code> / 5-field <code>SchemaMetadataDto</code> wire payloads.</li>
          </ul>
        </li>
      </ul>
    ]]></change-notes>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>

    <applicationListeners>
        <listener class="org.stvnadore.plugin.validation.StvnIncludeDependencyWatcher"
                  topic="com.intellij.openapi.vfs.newvfs.BulkFileListener"/>
        <listener class="org.stvnadore.plugin.editor.StvnFileEditorListener"
                  topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
    </applicationListeners>

    <extensions defaultExtensionNs="com.intellij">
        <!-- 1. File Type Extension Registrations -->
        <fileType name="STVN_PAYLOAD"
                  language="STVN"
                  implementationClass="org.stvnadore.plugin.StvnFileType$Payload"
                  fieldName="INSTANCE"
                  extensions="stvn"/>

        <fileType name="STVN_DEFS"
                  language="STVN"
                  implementationClass="org.stvnadore.plugin.StvnFileType$Defs"
                  fieldName="INSTANCE"
                  extensions="stvn_d"/>

        <fileType name="STVN_DEFS_INCLUDE"
                  language="STVN"
                  implementationClass="org.stvnadore.plugin.StvnFileType$DefsInclude"
                  fieldName="INSTANCE"
                  extensions="stvn_di"/>

        <fileType name="STVN_PAYLOAD_INCLUDE"
                  language="STVN"
                  implementationClass="org.stvnadore.plugin.StvnFileType$PayloadInclude"
                  fieldName="INSTANCE"
                  extensions="stvn_i"/>

        <fileType name="STVN_BIN"
                  implementationClass="org.stvnadore.plugin.StvnBinaryFileType"
                  fieldName="INSTANCE"
                  extensions="stvn_b"/>

        <fileType name="STVN_BINARY_DEFS"
                  implementationClass="org.stvnadore.plugin.StvnBinaryDefsFileType"
                  fieldName="INSTANCE"
                  extensions="stvn_bd"/>

        <fileType name="STVN_IR"
                  language="TEXT"
                  implementationClass="org.stvnadore.plugin.StvnIrFileType"
                  fieldName="INSTANCE"
                  extensions="stvn_ir"/>

        <!-- 1d. Dynamic Substrate Enclave Icon Provider (*.stvn_ir.* and *.stvn_cas.*) -->
        <iconProvider implementation="org.stvnadore.plugin.icons.StvnIconProvider"/>

        <!-- 1b. Brace Matcher and Folding Builder -->
        <lang.braceMatcher language="STVN"
                           implementationClass="org.stvnadore.plugin.editor.StvnBraceMatcher"/>
        <lang.foldingBuilder language="STVN"
                             implementationClass="org.stvnadore.plugin.editor.StvnFoldingBuilder"/>

        <!-- 2. Core Parser Definition -->
        <lang.parserDefinition language="STVN"
                               implementationClass="org.stvnadore.plugin.StvnParserDefinition"/>

        <!-- 2b. Line Commenter -->
        <lang.commenter language="STVN"
                        implementationClass="org.stvnadore.plugin.lang.StvnCommenter"/>

        <!-- 2c. Enter Handler for Fenced String Delimiters -->
        <enterHandlerDelegate implementationClass="org.stvnadore.plugin.editor.StvnEnterInFencedStringHandler"/>

        <!-- 2d. Typed Handler for Bracket Auto-Pairing in Fenced Strings -->
        <typedHandler implementationClass="org.stvnadore.plugin.editor.StvnFencedStringTypedHandler"/>

        <!-- 2e. Rename Handler for Balanced Fenced String Delimiter Tags -->
        <renameHandler implementation="org.stvnadore.plugin.editor.StvnFencedStringTagRenameHandler"/>

        <!-- 2f. Refactoring Names Validator -->
        <lang.namesValidator language="STVN"
                             implementationClass="org.stvnadore.plugin.refactoring.StvnNamesValidator"/>

        <renameInputValidator implementation="org.stvnadore.plugin.refactoring.StvnRenameInputValidator"/>

        <!-- 2g. Section Navigation Line Marker Provider -->
        <codeInsight.lineMarkerProvider language="STVN"
                                        implementationClass="org.stvnadore.plugin.browser.StvnSectionNavigationLineMarkerProvider"/>

        <!-- 3. Annotator for downstream tag parity semantic checks -->
        <annotator language="STVN"
                   implementationClass="org.stvnadore.plugin.validation.StvnSemanticAnnotator"/>

        <!-- 4. Syntax Highlighting & Coloring -->
        <lang.syntaxHighlighterFactory language="STVN"
                                       implementationClass="org.stvnadore.plugin.StvnSyntaxHighlighterFactory"/>

        <colorSettingsPage implementation="org.stvnadore.plugin.StvnColorSettingsPage"/>

        <!-- 4b. Native Formatter & Code Style Providers -->
        <lang.formatter language="STVN"
                        implementationClass="org.stvnadore.plugin.formatting.StvnFormattingModelBuilder"/>

        <preFormatProcessor implementation="org.stvnadore.plugin.formatting.StvnMetadataOrderPreFormatProcessor"/>

        <postFormatProcessor implementation="org.stvnadore.plugin.formatting.StvnCoreDelegationPostFormatProcessor"/>

        <codeStyleSettingsProvider
                implementation="org.stvnadore.plugin.formatting.StvnCodeStyleSettingsProvider"/>

        <langCodeStyleSettingsProvider
                implementation="org.stvnadore.plugin.formatting.StvnLanguageCodeStyleSettingsProvider"/>

        <!-- 5. Real-time Compiler Diagnostics Bridge -->
        <externalAnnotator language="STVN"
                           implementationClass="org.stvnadore.plugin.validation.StvnExternalAnnotator"/>

        <!-- 5b. Project View Problem Highlighter Filter -->
        <problemFileHighlightFilter implementation="org.stvnadore.plugin.validation.StvnProblemFileHighlightFilter"/>

        <!-- 5c. Grammar-Kit PSI Error Element Suppressor -->
        <highlightErrorFilter implementation="org.stvnadore.plugin.validation.StvnHighlightErrorFilter"/>

        <!-- 6. Find Usages Support -->
        <lang.findUsagesProvider language="STVN"
                                 implementationClass="org.stvnadore.plugin.findusages.StvnFindUsagesProvider"/>

        <!-- 6b. Goto Symbol Navigation -->
        <chooseByNameContributor implementation="org.stvnadore.plugin.reference.StvnChooseByNameContributor"/>

        <!-- 6c. PSI Reference Contributor -->
        <lang.elementManipulator
                forClass="org.stvnadore.psi.StringLiteral"
                implementationClass="org.stvnadore.plugin.psi.StvnStringLiteralManipulator"/>
        <psi.referenceContributor language="STVN"
                                  implementation="org.stvnadore.plugin.reference.StvnReferenceContributor"/>

        <!-- 6d. Goto Declaration Handler -->
        <gotoDeclarationHandler implementation="org.stvnadore.plugin.navigation.StvnGotoDeclarationHandler"/>

        <!-- 6e. Target Element Evaluator -->
        <targetElementEvaluator language="STVN"
                                implementationClass="org.stvnadore.plugin.navigation.StvnTargetElementEvaluator"/>

        <!-- 7. Inlay Hints Provider -->
        <codeInsight.inlayProvider
                language="STVN"
                implementationClass="org.stvnadore.plugin.hints.StvnTypeInlayHintsProvider"/>

        <!-- 7b. Code Completion Contributor -->
        <completion.contributor
                language="STVN"
                implementationClass="org.stvnadore.plugin.completion.StvnValueCompletionContributor"/>
        <completion.contributor
                language="STVN"
                implementationClass="org.stvnadore.plugin.completion.StvnMetadataCompletionContributor"/>
        <completion.contributor
                language="STVN"
                implementationClass="org.stvnadore.plugin.completion.StvnPackageCompletionContributor"/>
        <completion.contributor
                language="STVN"
                implementationClass="org.stvnadore.plugin.completion.StvnIncludeCompletionContributor"/>

        <!-- 8. Project-Scoped Settings Component -->
        <projectService serviceImplementation="org.stvnadore.plugin.settings.StvnProjectSettings"/>
        <projectService serviceImplementation="org.stvnadore.plugin.settings.StvnSettings"/>
        <projectService serviceImplementation="org.stvnadore.plugin.settings.StvnRepositorySettings"/>

        <projectConfigurable groupId="language"
                             instance="org.stvnadore.plugin.settings.StvnConfigurable"
                             id="org.stvnadore.plugin.settings.StvnConfigurable"
                             displayName="STVN"
                             icon="/icons/stvn_file.svg"/>

        <projectConfigurable parentId="tools"
                             instance="org.stvnadore.plugin.settings.StvnRepositorySettingsConfigurable"
                             id="org.stvnadore.plugin.settings.StvnRepositorySettingsConfigurable"
                             displayName="STVN Schema Repository"
                             nonDefaultProject="false"/>

        <!-- 9. Documentation Provider -->
        <lang.documentationProvider language="STVN"
                                    implementationClass="org.stvnadore.plugin.documentation.StvnDocumentationProvider"/>

        <!-- Structure View and Breadcrumbs Navigation -->
        <lang.psiStructureViewFactory language="STVN"
                                      implementationClass="org.stvnadore.plugin.structure.StvnStructureViewFactory"/>
        <breadcrumbsInfoProvider implementation="org.stvnadore.plugin.breadcrumbs.StvnBreadcrumbsInfoProvider"/>

        <!-- 10. Local Inspection for Variant tag style -->
        <localInspection language="STVN"
                         shortName="StvnVariantStyle"
                         displayName="Variant tag style inspection"
                         groupPath="STVN"
                         groupName="Style"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="org.stvnadore.plugin.validation.StvnVariantStyleInspection"/>

        <!-- 11. Local Inspection for Boolean validity -->
        <localInspection language="STVN"
                         shortName="StvnBooleanValidity"
                         displayName="Boolean validity inspection"
                         groupPath="STVN"
                         groupName="Validity"
                         enabledByDefault="true"
                         level="ERROR"
                         implementationClass="org.stvnadore.plugin.validation.StvnBooleanValidityInspection"/>

        <!-- 12. Local Inspection for Flat list in map slot -->
        <localInspection language="STVN"
                         shortName="StvnMapStructural"
                         displayName="Flat list in map slot inspection"
                         groupPath="STVN"
                         groupName="Structural"
                         enabledByDefault="true"
                         level="ERROR"
                         implementationClass="org.stvnadore.plugin.validation.StvnMapStructuralInspection"/>

        <!-- 12b. Local Inspection for Degraded Schemas -->
        <localInspection language="STVN"
                         shortName="StvnDegradedSchema"
                         displayName="Degraded schema payload evaluation"
                         groupPath="STVN"
                         groupName="Quality &amp; Semantics"
                         enabledByDefault="true"
                         level="WEAK WARNING"
                         implementationClass="org.stvnadore.plugin.validation.StvnDegradedSchemaInspection"/>

        <!-- 12c. Local Inspection for Degenerate Arity-1 Composites -->
        <localInspection language="STVN"
                         shortName="StvnDegenerateComposite"
                         displayName="Degenerate arity-1 composite schema"
                         groupPath="STVN"
                         groupName="Schema Design"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="org.stvnadore.plugin.validation.StvnDegenerateCompositeInspection"/>

        <!-- 12d. Local Inspection for Enum Subset Filtering -->
        <localInspection language="STVN"
                         shortName="StvnEnumSubset"
                         displayName="Enum subset filtering inspection"
                         groupPath="STVN"
                         groupName="Semantics"
                         enabledByDefault="true"
                         level="ERROR"
                         implementationClass="org.stvnadore.plugin.validation.StvnEnumSubsetInspection"/>

        <!-- 12e. Local Inspection for Fenced String Delimiters (Rule STR-04) -->
        <localInspection language="STVN"
                         shortName="StvnFencedString"
                         displayName="Fenced string delimiter inspection"
                         groupPath="STVN"
                         groupName="Syntax"
                         enabledByDefault="true"
                         level="ERROR"
                         implementationClass="org.stvnadore.plugin.validation.StvnFencedStringInspection"/>

        <!-- 12f. Local Inspection for LHS Reserved Types -->
        <localInspection language="STVN"
                         shortName="StvnLhsReservedType"
                         displayName="LHS reserved type inspection"
                         groupPath="STVN"
                         groupName="Semantics"
                         enabledByDefault="true"
                         level="ERROR"
                         implementationClass="org.stvnadore.plugin.validation.StvnLhsReservedTypeInspection"/>

        <!-- 12g. Local Inspection for Constant Integer Range -->
        <localInspection language="STVN"
                         shortName="StvnConstantRange"
                         displayName="Constant integer range inspection"
                         groupPath="STVN"
                         groupName="Validity"
                         enabledByDefault="true"
                         level="ERROR"
                         implementationClass="org.stvnadore.plugin.validation.StvnConstantRangeInspection"/>

        <!-- 12h. Local Inspection for Flat Document Includes -->
        <localInspection language="STVN"
                         shortName="StvnFlatDocumentInclude"
                         displayName="Flat document include inspection"
                         groupPath="STVN"
                         groupName="Structural"
                         enabledByDefault="true"
                         level="ERROR"
                         implementationClass="org.stvnadore.plugin.validation.StvnFlatDocumentIncludeInspection"/>

        <!-- 12i. Local Inspection for Nested Package Enclosures -->
        <localInspection language="STVN"
                         shortName="StvnNestedPackage"
                         displayName="Nested package inspection"
                         groupPath="STVN"
                         groupName="Structural"
                         enabledByDefault="true"
                         level="ERROR"
                         implementationClass="org.stvnadore.plugin.validation.StvnNestedPackageInspection"/>

        <!-- 12j. Local Inspection for Trailing Slashes in :use Targets -->
        <localInspection language="STVN"
                         shortName="StvnTrailingSlash"
                         displayName="Trailing slash inspection"
                         groupPath="STVN"
                         groupName="Syntax"
                         enabledByDefault="true"
                         level="ERROR"
                         implementationClass="org.stvnadore.plugin.validation.StvnTrailingSlashInspection"/>

        <!-- 12k. Local Inspection for String Capacity Governance -->
        <localInspection language="STVN"
                         shortName="StvnStringCapacity"
                         displayName="String capacity governance inspection"
                         groupPath="STVN"
                         groupName="Governance"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="org.stvnadore.plugin.validation.StvnStringCapacityInspection"/>

        <!-- 12k2. Local Inspection for Exact Float Mantissa Precision -->
        <localInspection language="STVN"
                         shortName="StvnExcessiveExactFloatPrecision"
                         displayName="Excessive exact float mantissa precision inspection"
                         groupPath="STVN"
                         groupName="Governance"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="org.stvnadore.plugin.validation.StvnExcessiveExactFloatPrecisionInspection"/>

        <!-- 12k3. Local Inspection for Continuous Float Precision Loss -->
        <localInspection language="STVN"
                         shortName="StvnFloatPrecisionLoss"
                         displayName="Continuous float precision loss inspection"
                         groupPath="STVN"
                         groupName="Numeric &amp; Floating-Point"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="org.stvnadore.plugin.validation.StvnFloatPrecisionLossInspection"/>

        <!-- 12l. Local Inspection for Metadata Facet & Empty Block Governance -->
        <localInspection language="STVN"
                         shortName="StvnMetadataFacet"
                         displayName="Metadata facet and block governance inspection"
                         groupPath="STVN"
                         groupName="Governance"
                         enabledByDefault="true"
                         cleanupTool="true"
                         level="ERROR"
                         implementationClass="org.stvnadore.plugin.validation.StvnMetadataFacetInspection"/>

        <!-- 12m. Local Inspection for String Cardinality Governance -->
        <localInspection language="STVN"
                         shortName="StvnStringCardinality"
                         displayName="String cardinality facet governance inspection"
                         groupPath="STVN"
                         groupName="Governance"
                         enabledByDefault="true"
                         level="ERROR"
                         implementationClass="org.stvnadore.plugin.validation.StvnStringCardinalityInspection"/>

        <!-- 12n. Local Inspection for Discrete Numeric Interval Bounds -->
        <localInspection language="STVN"
                         shortName="StvnDiscreteInterval"
                         displayName="Discrete interval bound governance inspection"
                         groupPath="STVN"
                         groupName="Governance"
                         enabledByDefault="true"
                         level="ERROR"
                         implementationClass="org.stvnadore.plugin.validation.StvnDiscreteIntervalInspection"/>

        <!-- 12o. Local Inspection for Temporal Mode and Unit Facets -->
        <localInspection language="STVN"
                         shortName="StvnTemporalMode"
                         displayName="Temporal mode and unit facet governance inspection"
                         groupPath="STVN"
                         groupName="Governance"
                         enabledByDefault="true"
                         level="ERROR"
                         implementationClass="org.stvnadore.plugin.validation.StvnTemporalModeInspection"/>

        <!-- 12p. Local Inspection for Metadata Facet Ordering (5-Tier Decimal Hierarchy) -->
        <localInspection language="STVN"
                         shortName="StvnMetadataOrder"
                         displayName="Metadata facet canonical ordering inspection"
                         groupPath="STVN"
                         groupName="Governance"
                         enabledByDefault="true"
                         level="ERROR"
                         implementationClass="org.stvnadore.plugin.validation.StvnMetadataOrderInspection"/>

        <!-- 12q. Local Inspection for Redundant Metadata Facet Overrides -->
        <localInspection language="STVN"
                         shortName="StvnRedundantFacetOverride"
                         displayName="Redundant metadata facet override inspection"
                         groupPath="STVN"
                         groupName="Governance"
                         enabledByDefault="true"
                         cleanupTool="true"
                         level="WARNING"
                         implementationClass="org.stvnadore.plugin.validation.StvnRedundantFacetOverrideInspection"/>

        <!-- 12r. Local Inspection for Unresolved Type References -->
        <localInspection language="STVN"
                         shortName="StvnUnresolvedType"
                         displayName="Unresolved type reference inspection"
                         groupPath="STVN"
                         groupName="Semantics"
                         enabledByDefault="true"
                         level="ERROR"
                         implementationClass="org.stvnadore.plugin.validation.StvnUnresolvedTypeInspection"/>

        <!-- 12s. Local Inspection for Zero-Tab Invariant -->
        <localInspection language="STVN"
                         shortName="StvnTabCharacter"
                         displayName="Tab character forbidden inspection"
                         groupPath="STVN"
                         groupName="Governance"
                         enabledByDefault="true"
                         level="ERROR"
                         implementationClass="org.stvnadore.plugin.validation.StvnTabCharacterInspection"/>

        <!-- 12t. Local Inspection for Missing Root Meta Block -->
        <localInspection language="STVN"
                         shortName="StvnMissingMeta"
                         displayName="Missing root metadata block inspection"
                         groupPath="STVN"
                         groupName="Governance"
                         enabledByDefault="true"
                         level="ERROR"
                         implementationClass="org.stvnadore.plugin.validation.StvnMissingMetaInspection"/>

        <!-- 12u. Local Inspection for Document Stem Mismatch -->
        <localInspection language="STVN"
                         shortName="StvnStemMismatch"
                         displayName="Document stem mismatch inspection"
                         groupPath="STVN"
                         groupName="Governance"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="org.stvnadore.plugin.validation.StvnStemMismatchInspection"/>

        <!-- 12v. Local Inspection for Suspicious TimeEpoch Magnitude -->
        <localInspection language="STVN"
                         shortName="StvnSuspiciousEpochMagnitude"
                         displayName="Suspicious epoch magnitude inspection"
                         groupPath="STVN"
                         groupName="Governance"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="org.stvnadore.plugin.validation.StvnSuspiciousEpochMagnitudeInspection"/>

        <!-- 13. Notification Group for Workspace compilation alerts -->
        <notificationGroup id="STVN Workspace Group" displayType="BALLOON"/>

        <!-- 13b. Notification Group for STVN Repository Client Alerts -->
        <notificationGroup id="STVN Repository Group" displayType="BALLOON"/>

        <!-- 13c. Live Templates -->
        <defaultLiveTemplates file="liveTemplates/STVN.xml"/>
        <liveTemplateContext contextId="STVN" implementation="org.stvnadore.plugin.templates.StvnTemplateContextType"/>

        <!-- 13d. Intention Action for Bare Triple-Quote to Fenced String Block -->
        <intentionAction>
            <className>org.stvnadore.plugin.actions.StvnCreateFencedStringIntention</className>
            <category>STVN</category>
            <descriptionDirectoryName>StvnCreateFencedStringIntention</descriptionDirectoryName>
            <description>Convert bare triple-quote string to fenced string block</description>
        </intentionAction>

        <!-- 14. Schema-Driven Skeleton Generator Intention Action -->
        <intentionAction>
            <className>org.stvnadore.plugin.actions.StvnSchemaSkeletonIntentionAction</className>
            <category>STVN</category>
            <descriptionDirectoryName>StvnSchemaSkeletonIntentionAction</descriptionDirectoryName>
            <description>Scaffolds canonical data templates from resolved document schemas</description>
        </intentionAction>

        <!-- 14b. Context Action for Adding Root :meta Header -->
        <intentionAction>
            <className>org.stvnadore.plugin.intentions.StvnAddMetaBlockIntention</className>
            <category>STVN</category>
            <descriptionDirectoryName>StvnAddMetaBlockIntention</descriptionDirectoryName>
            <description>Inserts a canonical root :meta header conforming to file stem and document kind</description>
        </intentionAction>

        <!-- 14c. Context Action for Bootstrapping Empty STVN Document -->
        <intentionAction>
            <className>org.stvnadore.plugin.intentions.StvnBootstrapDocumentIntentionAction</className>
            <category>STVN</category>
            <descriptionDirectoryName>StvnBootstrapDocumentIntentionAction</descriptionDirectoryName>
            <description>Bootstraps a minimal valid STVN document structure conforming to file extension</description>
        </intentionAction>

    </extensions>

    <actions>
        <action id="org.stvnadore.plugin.actions.StvnFlattenWorkspaceAction"
                class="org.stvnadore.plugin.actions.StvnFlattenWorkspaceAction"
                text="Flatten STVN Workspace"
                description="Resolves workspace dependencies and exports a canonical hermetic .stvn_d schema">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="after" relative-to-action="WeighingAction"/>
            <add-to-group group-id="BuildMenu" anchor="last"/>
        </action>

        <action id="org.stvnadore.plugin.actions.PublishSchemaAction"
                class="org.stvnadore.plugin.actions.PublishSchemaAction"
                text="Publish Schema to STVN Repository"
                description="Publishes flattened STVN schema to the configured remote STVN Schema Repository"
                icon="/icons/stvn_file.svg">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="after" relative-to-action="org.stvnadore.plugin.actions.StvnFlattenWorkspaceAction"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>

        <group id="org.stvnadore.plugin.actions.StvnEditorPopupMenu"
               text="STVN"
               description="STVN data projection and formatting actions"
               popup="true">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <action id="org.stvnadore.plugin.browser.StvnBrowseNamespaceAction"
                    class="org.stvnadore.plugin.browser.StvnBrowseNamespaceAction"
                    text="Browse Namespace Dependencies"
                    description="Inspects and filters symbols across document sections in an interactive table popup"
                    icon="/icons/stvn_file.svg">
                <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt N"/>
                <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta alt N"/>
                <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta alt N"/>
            </action>
            <action id="org.stvnadore.plugin.actions.StvnConvertToPrettyPrintAction"
                    class="org.stvnadore.plugin.actions.StvnConvertToPrettyPrintAction"
                    text="Canonicalize &amp; Pretty Print"
                    description="Formats active STVN document with 2-space indentation and long-form symbols"/>
            <action id="org.stvnadore.plugin.actions.StvnConvertToCompactPrintAction"
                    class="org.stvnadore.plugin.actions.StvnConvertToCompactPrintAction"
                    text="Canonicalize &amp; Compact Print"
                    description="Formats active STVN document into compact single-line layout with short-form symbols"/>
            <action id="org.stvnadore.plugin.actions.StvnCopyCanonicalPrettyPrintAction"
                    class="org.stvnadore.plugin.actions.StvnCopyCanonicalPrettyPrintAction"
                    text="Copy Canonical Pretty Print to Clipboard"
                    description="Copies canonical pretty-printed format to the system clipboard without modifying document"/>
            <action id="org.stvnadore.plugin.actions.StvnCopyCanonicalCompactPrintAction"
                    class="org.stvnadore.plugin.actions.StvnCopyCanonicalCompactPrintAction"
                    text="Copy Canonical Compact Print to Clipboard"
                    description="Copies canonical compact single-line layout to the system clipboard without modifying document"/>
        </group>
    </actions>
</idea-plugin>
